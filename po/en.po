#, python-brace-format
msgid "Compatibilidad ATS estimada: {percent} %"
msgstr "Estimated ATS compatibility: {percent} %"

#: src/grepleo/ui/radar_legend.py:78
msgid ""
"Un ATS es el programa con el que muchas empresas filtran los CV antes de que "
"los lea una persona. Es una estimación local: cada empresa configura el suyo."
msgstr "An ATS is the program many companies use to filter CVs before a person reads them. This is a local estimate: each company configures its own."

#: src/grepleo/ui/radar_legend.py:85
#, python-brace-format
msgid "fiabilidad {level}"
msgstr "reliability {level}"

#: src/grepleo/ui/radar_legend.py:89
#, python-brace-format
msgid ""
"Palabras clave: tu CV cita {found} de las {total} que pide la oferta "
"({percent} % ponderado por lo que las pide)."
msgstr "Keywords: your CV cites {found} of the {total} the offer asks for ({percent} % weighted by how much it asks for them)."

#: src/grepleo/ui/radar_legend.py:93
msgid ""
"Palabras clave: no se pueden contar, porque la oferta es una ficha resumida."
msgstr "Keywords: they cannot be counted, because the offer is a summary card."

#: src/grepleo/ui/radar_legend.py:95
#, python-format, python-brace-format
msgid ""
"Cargo: {percent} % de las palabras del título de la oferta aparecen en tu CV."
msgstr "Position: {percent} % of the words in the offer's title appear in your CV."

#: src/grepleo/ui/radar_legend.py:97
#, python-format, python-brace-format
msgid ""
"Estructura del CV: {percent} % de las secciones estándar con contenido (la "
"experiencia pesa el doble)."
msgstr "CV structure: {percent} % of the standard sections have content (experience counts double)."

#: src/grepleo/ui/radar_legend.py:100
#, python-brace-format
msgid ""
"Requisitos eliminatorios que no cumples: {names}. Cada uno resta un 40 %."
msgstr "Knock-out requirements you do not meet: {names}. Each one takes off 40 %."

#: src/grepleo/ui/radar_legend.py:103
msgid ""
"Requisitos eliminatorios (experiencia, estudios, idiomas): ninguno "
"incumplido."
msgstr "Knock-out requirements (experience, education, languages): none unmet."

#: src/grepleo/ui/radar_legend.py:105
#, python-brace-format
msgid "{count} requisito no se puede saber con esta oferta."
msgid_plural "{count} requisitos no se pueden saber con esta oferta."
msgstr[0] "{count} requirement cannot be known with this offer."
msgstr[1] "{count} requirements cannot be known with this offer."

